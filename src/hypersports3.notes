# ======================================================================
# LA TABLA DE NOVENTA
# ======================================================================
# Que son noventa entradas y no otra cosa lo dicen SUS DOS LECTORES, que la
# recorren en los dos sentidos:
#
#     0x732F  ld hl,07346h / call L_4046 / ld a,(hl)      indice A
#     0x7338  sub 05ah / neg / ld hl,07346h / ...         indice 90 - A
#
# El 0x5A del segundo es 90, y 0x7346 + 90 = 0x73A0, que es justo donde
# vuelve a empezar el codigo.
D 0x7346 0x73a0 tabla_de_noventa  90 valores, leidos por 0x732F con el indice y por 0x733D con 90 menos el indice
F 0x7346 15

# ======================================================================
# LOS RECTANGULOS CON RECORTE, Y LOS DIGITOS GRANDES
# ======================================================================
# L_AF7C dibuja un rectangulo de la tabla de nombres teniendo en cuenta el
# DESPLAZAMIENTO de la pantalla, que saca de (0xE20D) dividido por ocho. Su
# cabecera son cinco bytes:
#
#     [columna x]  [ancho]  [alto]  [destino de VRAM, word]
#
# y lo curioso es que cada figura trae DOS juegos de datos del mismo tamano:
# el que va pegado detras de la cabecera y otro aparte. Cual se usa lo decide
# el acarreo de `x - desplazamiento`, o sea si la figura esta o no recortada
# por la izquierda. El `ex de,hl` de 0xAF9D es el que los intercambia.
#
# Los seis pares que hay, con quien los carga, y su encaje al byte:
#
#     0x8262 (5x12)  datos en 0x8267, los otros en 0x82AC   desde 0x5DCC
#     0x82A3 (4x1)   datos en 0x82A8, los otros en 0x82E8   desde 0x5D6F
#     0x842C (3x2)   datos en 0x8431, los otros en 0x8437   desde 0x5ED1
#     0x843D (3x2)   datos en 0x8442, los otros en 0x8448   desde 0x5EAE
#     0x844E (39x2)  datos en 0x8453, los otros en 0x84A1   desde 0x5EB7
#     0xB07F (20x12) datos en 0xB084, los otros en 0xB174   desde 0xAEA1
#     0xB264 (2x12)  datos en 0xB269, los otros en 0xB281   desde 0xAEAA
#     0xB299 (3x14)  datos en 0xB29E, los otros en 0xB2C8   desde 0xAE98
#
# El de 0x82EC es distinto y es el mas bonito: son los DIGITOS GRANDES de la
# marca. Su cabecera dice 5x3, o sea quince bytes por digito, y el codigo de
# 0x5DB2 multiplica el digito por quince (`add a,a` cuatro veces menos una)
# antes de sumarlo a los dos punteros. Diez digitos por diez son 150 bytes en
# cada juego: 0x82F1..0x8387 y 0x8387..0x841D.
D 0x8262 0x8267 cabecera_rectangulo_8262  x=62, 5 de ancho por 12 de alto, a la casilla 0x3960
F 0x8262 5
D 0x8267 0x82a3 rectangulo_8262  60 casillas, cinco por fila
F 0x8267 5
D 0x82a3 0x82a8 cabecera_rectangulo_82a3  x=59, 4 de ancho por 1 de alto, a la casilla 0x3AA0; la carga 0x5D72
F 0x82a3 5
D 0x82a8 0x82ac rectangulo_82a3  4 casillas: la version que se usa cuando la figura NO esta recortada por la izquierda
F 0x82a8 4
D 0x82ac 0x82e8 rectangulo_8262_recortado  las otras 60 casillas del de 0x8262, para cuando esta recortado por la izquierda
F 0x82ac 5
D 0x82e8 0x82ec rectangulo_82a3_recortado  las otras 4 casillas, las de cuando la figura si esta recortada; el `ex de,hl` de 0xAF9D elige entre las dos
F 0x82e8 4
D 0x82ec 0x82f1 cabecera_de_los_digitos  x, 5 de ancho por 3 de alto: quince casillas por digito
F 0x82ec 5
D 0x82f1 0x8387 digitos_grandes  150 B: los diez digitos de la marca, de quince casillas cada uno
F 0x82f1 15
D 0x8387 0x841d digitos_grandes_recortados  los mismos diez digitos, para cuando el marcador esta recortado por la izquierda
F 0x8387 15
D 0x841d 0x842c bloque_841d  15 B -una casilla mas de 5x3-; lo carga 0x6743
F 0x841d 15
D 0x842c 0x8431 cabecera_rectangulo_842c  x, 3 de ancho por 2 de alto, a la casilla 0x3AA0; la carga 0x5ECE, o sea el ultimo rectangulo que pinta el suelo
F 0x842c 5
D 0x8431 0x8437 rectangulo_842c  6 casillas: la version sin recortar
F 0x8431 3
D 0x8437 0x843d rectangulo_842c_recortado  las otras 6, las de cuando la figura entra cortada por la izquierda
F 0x8437 3
D 0x843d 0x8442 cabecera_rectangulo_843d  x, 3 de ancho por 2 de alto, a la casilla 0x3A80; la carga 0x5EAE
F 0x843d 5
D 0x8442 0x8448 rectangulo_843d  6 casillas: la version sin recortar
F 0x8442 3
D 0x8448 0x844e rectangulo_843d_recortado  las otras 6, las de cuando la figura entra cortada
F 0x8448 3
D 0x844e 0x8453 cabecera_rectangulo_844e  x, 39 de ancho por 2 de alto: la tira mas larga del cartucho
F 0x844e 5
D 0x8453 0x84a1 rectangulo_844e  78 casillas, 39 por fila: es la tira de suelo mas larga del cartucho
F 0x8453 13
D 0x84a1 0x84ef rectangulo_844e_recortado  las otras 78, las de cuando la tira entra cortada por la izquierda
F 0x84a1 13
