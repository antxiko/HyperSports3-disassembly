# ======================================================================
# HYPER SPORTS 3 (RC-733) - anotaciones del desensamblado
# ======================================================================
# Cada directiva D declara un rango de datos con su nombre y con la MEDIDA de
# la que sale. Ningun limite esta estimado a ojo.

# ======================================================================
# LA CABECERA
# ======================================================================
D 0x4000 0x4010 cabecera_del_cartucho  "AB" y la direccion de INIT (0x405A); STATEMENT, DEVICE y TEXT a cero, y los seis bytes reservados tambien
F 0x4000 w

# ======================================================================
# EL REPARTO DE ESCENAS: las once tablas del despachador
# ======================================================================
# Las once van PEGADAS detras de su `call L_4050`, que es el despachador que
# comparten los cartuchos de esta familia de Konami:
#
#     pop hl / add a,a / call L_4046 / ld e,(hl) / inc hl / ld d,(hl)
#     ex de,hl / jp (hl)
#
# El `pop hl` recupera su propia direccion de retorno, o sea el principio de
# la tabla. La cuenta de entradas no se estima: la fija el encaje de que
# ninguna entrada puede apuntar dentro de la propia tabla. Ver
# src/hypersports3.entries, donde estan las once con su aritmetica al byte.
D 0x4109 0x411b tabla_de_escenas  9 entradas, la mas alta del juego: reparte segun (0xE003) el logotipo, el titulo, las pruebas y el final
F 0x4109 w
D 0x5548 0x5550 tabla_de_subescenas_5548  4 entradas; el `and 003h` de 0x5542 dice que son cuatro y no mas
F 0x5548 w
D 0x5558 0x5560 tabla_de_subescenas_5558  4 entradas; detras sigue la primera de ellas, 0x5560
F 0x5558 w
D 0x58a3 0x58b3 tabla_de_subescenas_58a3  8 entradas; detras sigue la primera, 0x58B3
F 0x58a3 w
D 0x600f 0x601f tabla_de_subescenas_600f  8 entradas; detras sigue la primera, 0x601F
F 0x600f w
D 0x648d 0x649b tabla_de_subescenas_648d  7 entradas; detras sigue la primera, 0x649B
F 0x648d w
D 0x9111 0x9121 tabla_de_subescenas_9111  8 entradas; detras NO sigue ninguna, sino `ld c,a / ld a,(0e123h) / and a`
F 0x9111 w
D 0x9135 0x9141 tabla_de_subescenas_9135  6 entradas; detras sigue la primera, 0x9141
F 0x9135 w
D 0xa484 0xa494 tabla_de_subescenas_a484  8 entradas, simetricas dos a dos; detras sigue `ld ix,0e0a0h`
F 0xa484 w
D 0xa588 0xa58e tabla_de_subescenas_a588  3 entradas; la cuarta seria 0xA779 pero entonces la entrada [1] caeria dentro de la tabla
F 0xa588 w
D 0xa934 0xa94e tabla_de_subescenas_a934  13 entradas, la segunda mas larga; detras sigue la primera, 0xA94E
F 0xa934 w

# ======================================================================
# LO QUE INIT COPIA A LA RAM
# ======================================================================
# Los doce bytes que INIT copia a 0xE053 son LOS RECORDS DEL MUNDO, en BCD y
# con el byte de menos peso delante, tres por prueba y en el mismo orden en
# que L_57AB y L_9210 los reparten:
#     0xE053  34 45 01   ciclismo,     1:45.34
#     0xE056  97 17 00   triple salto,   17.97 m
#     0xE059  00 00 01   curling,       100 puntos
#     0xE05C  90 05 00   pertiga,         5.90 m
# Los dos que se pueden cotejar cuadran con la epoca del cartucho: los 17,97
# de Willie Banks son de junio de 1985 y los 5,90 de Sergei Bubka de 1984. Y
# no son constantes: viven en RAM porque el juego los SOBRESCRIBE cuando el
# jugador los bate (L_93D1 en el ciclismo), asi que duran lo que dure la
# maquina encendida.
D 0x40cf 0x40db records_del_mundo  12 bytes que INIT copia a 0xE053: los cuatro records, tres bytes en BCD cada uno
F 0x40cf 12

# ======================================================================
# LOS OCHO REGISTROS DEL VDP
# ======================================================================
# El bucle de 0x4488 los escribe en orden, del 0 al 7, sacando cada valor de
# esta tabla. De aqui sale TODO el reparto de la VRAM de este cartucho:
#
#   R0=02 R1=E2   SCREEN 2, pantalla activa, interrupcion, sprites de 16x16
#   R2=0E         tabla de nombres          0x3800..0x3AFF
#   R3=7F         color: base 0, mascara 0x3FF -> 0x0000..0x17FF
#   R4=07         patrones: base 0x2000     -> 0x2000..0x37FF
#   R5=76         atributos de sprite       0x3B00..0x3B7F
#   R6=03         patrones de sprite        0x1800..0x1FFF
#   R7=E4         tinta 14 sobre fondo 4
#
# En SCREEN 2 los R3 y R4 no son una direccion sino una base y una mascara, y
# por eso la pantalla queda partida en tres tercios con sus propios patrones:
# de ahi la rutina L_4405, que descomprime el mismo bloque en los tres.
D 0x4492 0x449a registros_del_vdp  los ocho valores, en orden, que escribe el bucle de 0x4488
F 0x4492 8

# ======================================================================
# LA PANTALLA DEL LOGOTIPO Y LA DEL TITULO
# ======================================================================
# Los tamanos NO estan estimados: cada bloque comprimido se ha EJECUTADO con
# tools/rle.py, que es el descompresor del cartucho rehecho en Python, y cada
# guion de rotulo con tools/guiones.py. Lo que cierra cada uno es su propio
# byte final -0x00 en el comprimido, 0xFF en el guion-, no una cuenta a ojo.
D 0x4514 0x4525 rle_konami_software  17 B -> 20 de VRAM: la raya de doce tiles de 0x394A y la palabra SOFTWARE en 0x396C
F 0x4514 17
D 0x4525 0x454c guion_del_menu  39 B, tres destinos: (c)KONAMI 1985 en 0x396A, PLAY SELECT en 0x39EB y 1PLAYER en 0x3A4D
F 0x4525 13,14,12
D 0x454c 0x4557 guion_2players  11 B: 2PLAYERS en 0x3A8D
F 0x454c 11
D 0x4557 0x455a guion_del_cursor  3 B SIN cabecera: los dos tiles de la manita, con el destino ya en HL; entra por L_441D desde 0x48AA
F 0x4557 3
D 0x455a 0x4561 guion_foul  7 B: FOUL en la casilla 0x3AAE de la pantalla; lo pinta 0xABC2 cuando la piedra del curling se sale de la pista
F 0x455a 7
D 0x4561 0x4565 guion_1up  4 B SIN cabecera: 1UP, con el destino ya en HL; lo carga 0x43AA
F 0x4561 4
D 0x4565 0x4569 guion_2up  4 B SIN cabecera: 2UP, con el destino ya en HL; lo carga 0x43AF
F 0x4565 4
D 0x459b 0x470c rle_la_fuente  369 B -> 384 de VRAM en 0x2080: los 48 patrones de la fuente, del tile 0x10 al 0x3F
F 0x459b 16
D 0x470c 0x471f rle_nombres_del_logotipo  19 B -> 16 casillas: el trozo de tabla de nombres que el propio bloque situa
F 0x470c 19
D 0x4773 0x480a rle_tiles_grandes  151 B -> 216 de VRAM en 0x2200: los 27 patrones del tile 0x40 al 0x5A
F 0x4773 16
D 0x4878 0x4889 lista_de_tiles_del_rotulo  17 B: pares [cuantos tiles][cuanto saltar] que escriben el rotulo HYPER SPORTS 3 en la tabla de nombres desde 0x386C, con el indice de tile subiendo solo desde 0xB0; el 0x00 cierra
F 0x4878 2
D 0x48ad 0x4a88 rle_patrones_del_rotulo  475 B -> 528 de VRAM en 0x2580: los 66 patrones del rotulo, del tile 0xB0 al 0xF1
F 0x48ad 16
D 0x4a88 0x4aa5 rle_color_del_rotulo  29 B -> las mismas 528 posiciones en 0x0580, o sea el color de esos 66 tiles
F 0x4a88 16
D 0x4aa5 0x4ad2 bloques_repetidos_del_rotulo  45 B: cuatro entradas [cuantas veces][destino de VRAM][8 bytes de patron] y el 0x00 que cierra; el bucle de 0x4835 repite cada bloque de ocho bytes en casillas consecutivas de los tres tercios
F 0x4aa5 11,11,11,11,1

# ======================================================================
# EL SONIDO
# ======================================================================
# El reproductor entero vive entre 0x4AD2 y 0x4DA2, y sus datos justo detras.
# La puerta es L_4ADD: se le pasa en A el numero de sonido, con las
# prioridades en los bits de arriba.
#
# La tabla de pistas acaba EXACTAMENTE en su entrada mas baja, 0x4E1C, que es
# donde empiezan los datos. Su entrada [0] vale 0x393C, que no es ni una
# direccion de la ROM: el sonido 0 no existe, porque el reproductor arranca
# comparando con `cp 001h`.
# LA TABLA DE PERIODOS TIENE DOCE VALORES, NO DIEZ, y los dos ultimos estan
# ESCONDIDOS DENTRO DE LA TABLA DE PUNTEROS QUE VIENE DETRAS.
#
# L_4D75 la indexa con el nibble alto del byte de nota, que llega hasta 0x0B
# antes de que el `sub 00ch` mande el 0x0C al silencio. Con 0x0A y 0x0B leeria
# 0x4DAC y 0x4DAD, que son los dos bytes de la entrada [0] de la tabla de
# pistas. Y esos dos bytes valen 0x3C y 0x39.
#
#      n   byte   107 * 2^(-n/12)        n   byte   107 * 2^(-n/12)
#      0   0x6B      107,00              6   0x4C       75,66
#      1   0x65      100,99              7   0x47       71,41
#      2   0x5F       95,33              8   0x43       67,41
#      3   0x5A       89,98              9   0x40       63,62
#      4   0x55       84,93             10   0x3C       60,05   <- 0x4DAC
#      5   0x50       80,16             11   0x39       56,68   <- 0x4DAD
#
# Los doce caen a menos de uno del semitono exacto: es una octava cromatica
# entera. Asi que la entrada [0] de la tabla de pistas, la que apunta al
# 0x393C que no es ninguna melodia, NO es una entrada muerta: son los dos
# semitonos de arriba. Konami solapo las dos tablas para ahorrarse dos bytes.
#
# Las dos directivas D de abajo tienen que partir por 0x4DAC porque un byte no
# puede salir dos veces en el listado, pero los doce valores son uno solo.
# Medido con tools/recorre_pistas.py, que recorre las pistas largas que el
# cartucho arranca de verdad: los nibbles 0x0A y 0x0B salen en las 0xA3, 0xA6
# y 0xAC, o sea que los dos ultimos SE USAN.
D 0x4da2 0x4dac tabla_de_periodos  los diez primeros de los DOCE semitonos de la octava, cada uno 0,944 veces el anterior; los dos que faltan son los dos primeros bytes del bloque de abajo
F 0x4da2 10
D 0x4dac 0x4e1c tabla_de_pistas  56 punteros de dos bytes que L_4B32 indexa con el numero de sonido; su entrada [0] no es un puntero: sus dos bytes son los semitonos 10 y 11 de la tabla de arriba, y por eso parece apuntar a 0x393C
F 0x4dac w
D 0x4e1c 0x53b0 pistas_de_sonido  1428 bytes de melodias y efectos; cada byte lleva la nota en el nibble alto y la duracion en el bajo, y el nibble alto 0x0C es el silencio
F 0x4e1c 16
D 0x53b0 0x53b1 fin_de_pista  un solo 0xFF, al que apuntan las tres ultimas entradas de la tabla y la [1]: la pista muda
F 0x53b0 1

# ======================================================================
# LOS ROTULOS DE LAS CUATRO PRUEBAS
# ======================================================================
# 0x5A90 es la que dice EN QUE ORDEN van las pruebas, y no hay que suponerlo:
# el codigo de 0x5913 hace `ld a,(0e06ah) / and 003h / add a,a` y entra aqui,
# o sea que el indice es el mismo (0xE06A) que reparte el juego entero.
#
#     (0xE06A) & 3 = 0 -> 0x5AB3  CYCLING
#                    1 -> 0x5A98  TRIPLE JUMP
#                    2 -> 0x5ABD  CURLING
#                    3 -> 0x5AA6  POLE VAULT
#
# Y ese mismo indice reparte el motor de cada prueba en la tabla de 0x5548:
# 0x9105, 0x5550, 0xA92E y 0x5550. La primera y la tercera van a sitios
# propios, pero **el triple salto y el salto con pertiga comparten motor**:
# las dos entran por 0x5550.
D 0x5a7d 0x5a90 guion_game_over  19 B SIN cabecera: " PLAYER  GAME OVER "
F 0x5a7d 19
D 0x5a90 0x5a98 tabla_de_nombres_de_prueba  4 punteros; el indice es (0xE06A) y 3
F 0x5a90 w
D 0x5a98 0x5aa6 guion_triple_jump  14 B: TRIPLE JUMP en 0x386B
F 0x5a98 14
D 0x5aa6 0x5ab3 guion_pole_vault  13 B: POLE VAULT en 0x386B
F 0x5aa6 13
D 0x5ab3 0x5abd guion_cycling  10 B: CYCLING en 0x386B
F 0x5ab3 10
D 0x5abd 0x5ac7 guion_curling  10 B: CURLING en 0x386B
F 0x5abd 10
D 0x5ac7 0x5afa guion_de_marcadores  51 B, cinco destinos: HI SCORE, WORLD RECORD, RECORD, SCORE y TOTAL
F 0x5ac7 11,12,10,9,9
D 0x5afa 0x5b39 guion_you_did_it  63 B, tres destinos: YOU DID IT y CONGRATULATIONS, con su linea de borrado
F 0x5afa 19,29,15
D 0x5b39 0x5c0f rle_nombres_del_resumen  214 B -> 800 casillas de la tabla de nombres
F 0x5b39 16
D 0x5c0f 0x5c66 rle_patrones_del_resumen  87 B -> 152 de VRAM en 0x2400, o sea los 19 patrones desde el tile 0x80
F 0x5c0f 16
D 0x5c66 0x5ca0 rle_color_del_resumen  58 B -> las mismas 152 posiciones en 0x0400
F 0x5c66 16

# ======================================================================
# LOS ATLETAS: figuras y patrones de sprite
# ======================================================================
# Un atleta no es un sprite: son de dos a siete sprites de 16x16 puestos uno
# al lado de otro, y sus patrones NO viven en la VRAM esperando. Cada cuadro
# se DESCOMPRIMEN otra vez encima de los mismos 2 KB de 0x1800, que es donde
# el VDP los busca (R6 = 0x03).
#
# El motor es L_6992. Cada pieza son cinco bytes -dy, dx, puntero al patron
# (word) y color-, y un 0x80 en el sitio del dy cierra la figura y apaga los
# sprites que sobren. Todo esto esta ejecutado en tools/retales.py; los
# tamanos salen de ahi, no de una cuenta a ojo.
#
# Cada tabla acaba EXACTAMENTE en su entrada mas baja. Las cinco:
#
#   0x6B00  13 entradas, 2 piezas   patrones 0x8722..0x881D
#   0x6B6A  13 entradas, 4 piezas   patrones 0x8614..0x8721
#   0x6BD9  14 entradas, 7 piezas   patrones 0x862F..0x8B00
#   0x6D5C   6 entradas, 4 piezas   patrones 0x8B01..0x8CDC
#   0x6E33  ...                     patrones 0x8D11..0x906A
D 0x6b00 0x6b1a tabla_de_figuras_6b00  13 punteros; la mas baja es 0x6B1A, que es donde acaba la tabla
F 0x6b00 w
D 0x6b1a 0x6b6a figuras_6b1a  80 B: ocho figuras de dos piezas de cinco bytes
F 0x6b1a 10
D 0x6b6a 0x6b84 tabla_de_figuras_6b6a  13 punteros; acaba en 0x6B84
F 0x6b6a w
D 0x6b84 0x6bd9 figuras_6b84  85 B: siete figuras de hasta cuatro piezas, cada una cerrada con su 0x80
F 0x6b84 11,16,20,16,11,11
D 0x6bd9 0x6bf5 tabla_de_figuras_6bd9  14 punteros; acaba en 0x6BF5
F 0x6bd9 w
D 0x6bf5 0x6d5c figuras_6bf5  359 B: catorce figuras de hasta siete piezas
F 0x6bf5 15
D 0x6d5c 0x6d68 tabla_de_figuras_6d5c  6 punteros; acaba en 0x6D68
F 0x6d5c w
D 0x6d68 0x6de6 figuras_6d68  126 B: seis figuras de cuatro piezas, 21 bytes cada una
F 0x6d68 21
D 0x6de6 0x6dea estado_inicial_de_0xe131  4 B que 0x5FD0 copia a 0xE131 con un `ldir`
F 0x6de6 4
D 0x6dea 0x6e06 atributos_de_sprite_iniciales  28 B que 0x6476 copia a 0xE0C4: siete sprites, con los patrones 0, 4, 8, 0x0C, 0x10, 0x14 y 0x18
F 0x6dea 4
D 0x6e06 0x6e0a estado_inicial_de_0xe0e4  4 B que 0x6052 y 0x6387 copian a 0xE0E4
F 0x6e06 4
D 0x6e0a 0x6e0e estado_inicial_de_0xe0e4_bis  4 B, el otro juego, desde 0x6102
F 0x6e0a 4
D 0x6e0e 0x6e15 guion_foul_en_juego  7 B SIN cabecera: " FOUL ", con el destino ya en HL; lo pintan 0x7528 y 0x754B
F 0x6e0e 7
D 0x6e15 0x6e24 figura_6e15  15 B: tres piezas, desde 0x64E0
F 0x6e15 5
D 0x6e24 0x6e33 figura_6e24  15 B: tres piezas, desde 0x653D
F 0x6e24 5
D 0x6e33 0x6e43 tabla_de_figuras_6e33  8 punteros; acaba en 0x6E43
F 0x6e33 w
D 0x6e43 0x6f1c figuras_6e43  217 B: ocho figuras de hasta siete piezas, las mas grandes del cartucho
F 0x6e43 15

# Los 127 bloques de patron a los que apuntan TODAS las figuras de arriba
# caen entre 0x8614 y 0x906A **sin dejar un solo byte suelto**: ejecutados uno
# a uno con tools/retales.py, el fin de cada bloque es el principio del
# siguiente. Los bytes en bruto no dicen donde acaba cada uno; lo dice su 0x00.
D 0x8614 0x906b patrones_de_sprite  127 bloques comprimidos encadenados: los atletas de las cuatro pruebas, que se descomprimen cada cuadro sobre los 2 KB de 0x1800
F 0x8614 16

# ======================================================================
# LAS MARCAS DE LAS PRUEBAS DE SALTO, EN BCD
# ======================================================================
# Los ocho primeros words son metros y centimetros en BCD, y el sexto, 17.89,
# es el record del mundo de TRIPLE SALTO de la epoca: los 17,89 m de Joao
# Carlos de Oliveira. Los diez siguientes son de PERTIGA, y acaban en 5.94.
D 0x757d 0x758d marcas_del_triple_salto  8 words en BCD: 13.00, 14.00, 15.00, 16.00, 17.00, 17.89, 18.00 y 20.00 metros
F 0x757d w
D 0x758d 0x75a1 marcas_de_la_pertiga  10 words en BCD: de 5.65 a 5.94 metros
F 0x758d w
D 0x75a1 0x75ab guion_qualify  10 B: QUALIFY en 0x3824
F 0x75a1 10

# ======================================================================
# LOS BLOQUES COMPRIMIDOS DE LAS PRUEBAS DE SALTO
# ======================================================================
# De 0x75AB a 0x8262 van QUINCE bloques comprimidos seguidos, sin un byte
# suelto entre ellos: el fin de cada uno -su 0x00- es el principio del
# siguiente. Todos ejecutados con tools/rle.py.
#
# Uno de ellos, el de 0x7818, no va a la VRAM sino a la RAM: lo lee L_74B1,
# que es el MISMO formato con otra salida, y que ademas saca el destino de
# los dos primeros bytes del bloque -aqui, 0xE320-.
D 0x75ab 0x760a rle_patrones_de_la_pista  95 B -> 168 de VRAM; lo cargan 0x5426 (en 0x2200) y 0x73DF (en 0x2748)
F 0x75ab 16
D 0x760a 0x7631 rle_color_de_la_pista  39 B -> 184 de VRAM; el color de los mismos, en 0x0200 o en 0x0748
F 0x760a 16
D 0x7631 0x7658 rle_patrones_7631  39 B -> 40 de VRAM en 0x1200, o sea patrones de SPRITE
F 0x7631 16
D 0x7658 0x766c rle_patrones_7658  20 B -> 24 de VRAM en los tres tercios desde 0x2030
F 0x7658 16
D 0x766c 0x7671 rle_color_7658  5 B -> las mismas 24 posiciones en 0x0030
F 0x766c 5
D 0x7671 0x76b3 rle_7671  66 B -> 160 de VRAM; lo carga 0x748B al montar la pista del triple salto y de la pertiga, detras del liston y de las colchonetas
F 0x7671 16
D 0x76b3 0x76c7 rle_speed  20 B -> 30 casillas de la tabla de nombres: el rotulo SPEED del marcador
F 0x76b3 16
D 0x76c7 0x775f rle_patrones_76c7  152 B -> 176 de VRAM en DOS tercios desde 0x2220 (L_4407 con B=2)
F 0x76c7 16
D 0x775f 0x7818 rle_color_76c7  185 B -> 208 de VRAM en dos tercios desde 0x0200
F 0x775f 16
D 0x7818 0x785d rle_a_ram_e320  69 B -> 80 bytes de RAM desde 0xE320; el destino son sus dos primeros bytes y lo descomprime L_74B1, que escribe en memoria y no en la VRAM
F 0x7818 16
D 0x785d 0x78e5 rle_785d  136 B -> 192 de VRAM
F 0x785d 16
D 0x78e5 0x799e rle_color_78e5  185 B -> 208 de VRAM en dos tercios desde 0x0200; es la ALTERNATIVA a 0x775F, y elige el bit 1 de (0xE003)
F 0x78e5 16
D 0x799e 0x79cf rle_799e  49 B -> 582 de VRAM en cuatro tramos
F 0x799e 16
D 0x79cf 0x79fb rle_79cf  44 B -> 587 de VRAM en dos tramos; la alternativa a 0x799E, y elige L_5F0F
F 0x79cf 16
D 0x79fb 0x8262 rle_pantalla_del_salto  2151 B -> 4048 de VRAM en SEIS tramos: el bloque mas gordo del cartucho
F 0x79fb 16
D 0x84ef 0x8614 rle_84ef  293 B -> 768 de VRAM
F 0x84ef 16
D 0x9d54 0x9d5f rle_9d54  11 B -> 48 de VRAM en los tres tercios desde 0x0500
F 0x9d54 11
D 0x9d5f 0x9f16 rle_patrones_9d5f  439 B -> 640 de VRAM en los tres tercios desde 0x2268
F 0x9d5f 16
D 0x9f16 0x9fa7 rle_color_9d5f  145 B -> las mismas 640 posiciones en 0x0268
F 0x9f16 16
D 0x9fa7 0x9fb7 rle_9fa7  16 B -> 16 de VRAM. Es el mismo flujo que se usa DOS veces: 0x5435 entra por 0x9FA7, donde los dos primeros bytes traen el destino, y 0x58C6 entra por 0x9FA9 con el destino en HL (0x22C0) y en los tres tercios
F 0x9fa7 16
D 0x9fb7 0xa232 rle_9fb7  635 B -> 928 de VRAM de una tacada
F 0x9fb7 16

# ======================================================================
# LOS QUINCE GUIONES DEL SEGUNDO INTERPRETE
# ======================================================================
# L_676E es el OTRO interprete de rotulos, y no es el mismo que L_4415: saca
# los bytes por `out (c),a` en vez de por WRTVRM, y sobre todo su 0xFE no trae
# una direccion nueva sino UN SOLO BYTE que se SUMA a la posicion. O sea que
# salta en relativo, que sale mas barato cuando el dibujo va por filas.
D 0x7132 0x7150 tabla_de_guiones_relativos  15 punteros; acaba en 0x7150, que es su entrada mas baja
F 0x7132 w
D 0x7150 0x732e guiones_relativos  478 B: los quince guiones que lee L_676E, con 0xFE para saltar en relativo y 0xFF para cerrar
F 0x7150 16

# ======================================================================
# EL MARCADOR Y EL RECORD
# ======================================================================
D 0x57f1 0x5800 guion_world_record  15 B: WORLD RECORD en 0x3823; lo pinta L_4430, o sea PARPADEANDO
F 0x57f1 15
